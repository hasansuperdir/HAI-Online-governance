        <mxCell id="a_s4_s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1B5E20;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_s4_s5" value="Deadline triggered" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#1B5E20;fontFamily=Arial;fontStyle=2;" vertex="1" connectable="0" parent="a_s4_s5">
          <mxGeometry x="-0.1" relative="1" as="geometry">
