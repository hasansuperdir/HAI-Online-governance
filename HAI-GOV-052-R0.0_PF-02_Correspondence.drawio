          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_s4_s7" value="Prepares response&#xa;within deadline" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#555555;fontFamily=Arial;fontStyle=2;" vertex="1" connectable="0" parent="a_s4_s7">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="45" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- SYSTEM: Step 5 — Track Deadline         -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="step5" value="&lt;b&gt;Step 5: System — Auto-Track Response Deadline&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Auto-calculate deadline per contract:&lt;br&gt;Contractor Notice Response = D+3 CD (SC 1.3)  |  NOD = 48h (SC 1.1.2.32)&lt;br&gt;Claim Notice = D+28 CD or D+7 CD for instructions (SC 20.2.1)&lt;br&gt;Fully Detailed Claim = D+7 CD (SC 20.2.4)  |  Post no-obj = 48h (SC 20.2.4)&lt;br&gt;Engineer Response = 15 WD ext. 21 WD (SC 1.9)  |  Determination = 28 CD (SC 3.5.1)&lt;br&gt;Countdown clock visible to all parties&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_system">
          <mxGeometry x="80" y="50" width="400" height="100" as="geometry"/>
        </mxCell>

