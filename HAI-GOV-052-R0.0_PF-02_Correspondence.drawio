          <mxGeometry x="455" y="45" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP 1: Draft Letter                    -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="step1" value="&lt;b&gt;Step 1: Sender (HAI PM)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Draft Letter Using Template&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;System enforces HAI reference numbering (A068-[CNT]-...)&lt;br&gt;Select type: Notice / NOD / Claim / Determination / Instruction / General&lt;br&gt;Paper-original signed by authorized representative (SC 1.3(a))&lt;br&gt;All communications addressed to Engineer (SC 1.3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_sender">
          <mxGeometry x="370" y="105" width="290" height="100" as="geometry"/>
        </mxCell>

