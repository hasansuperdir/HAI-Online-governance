        <mxCell id="step2" value="&lt;b&gt;Step 2: HAI Contracts Manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;Review High-Value / Contractual Letter&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Verify contractual basis, clause refs, time-bar compliance&lt;br&gt;Notices/Determinations/Claims require review (SC 1.3, 20.2)&lt;br&gt;&lt;b&gt;SLA: 1 WD internal turnaround&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_sender">
          <mxGeometry x="100" y="230" width="250" height="90" as="geometry"/>
