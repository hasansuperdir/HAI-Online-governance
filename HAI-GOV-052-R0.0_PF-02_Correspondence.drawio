        <mxCell id="lbl_rev_ok" value="Approved" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#1B5E20;fontFamily=Arial;fontStyle=3;" vertex="1" connectable="0" parent="a_rev_s3">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint y="-10" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP 4: Recipient Logs Receipt          -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="step4" value="&lt;b&gt;Step 4: Recipient&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log Receipt Date&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;System records receipt timestamp&lt;br&gt;Delivery confirmation sent to Sender&lt;br&gt;Response deadline clock starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C79100;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_recipient">
          <mxGeometry x="390" y="50" width="250" height="100" as="geometry"/>
        </mxCell>

        <!-- Arrow: Step 3 → Step 4 (cross-lane) -->
        <mxCell id="a_s3_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4A6FA5;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_s3_s4" value="Delivered" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#555555;fontFamily=Arial;fontStyle=2;" vertex="1" connectable="0" parent="a_s3_s4">
