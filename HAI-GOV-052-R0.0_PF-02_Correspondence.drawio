        <!-- ═══════════════════════════════════════ -->
        <mxCell id="overdue_decision" value="Response&lt;br&gt;Received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontStyle=1;fontFamily=Arial;fontColor=#1B2A4A;" vertex="1" parent="lane_system">
          <mxGeometry x="230" y="175" width="110" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="a_s5_od" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4A6FA5;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" source="step5" target="overdue_decision" parent="lane_system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP 6: SLA Escalation Chain            -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="step6" value="&lt;b&gt;Step 6: System — SLA Escalation Chain&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;AUTOMATED ESCALATION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;L1 (D-2): Pre-deadline reminder&lt;br&gt;L2 (D+0): Deadline alert to assignee + manager&lt;br&gt;L3 (D+3): Department Manager / Discipline Lead escalation&lt;br&gt;L4 (D+7): HAI PM / Programme Director executive alert&lt;br&gt;L5: TIME-BAR CRITICAL — Contracts Manager + Legal alert (48h before expiry)&lt;br&gt;Override: Formal extension by Engineer stops clock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_system">
          <mxGeometry x="560" y="155" width="340" height="120" as="geometry"/>
        </mxCell>

        <!-- Arrow: Overdue NO → Escalation -->
        <mxCell id="a_od_esc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#B71C1C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" source="overdue_decision" target="step6" parent="lane_system">
          <mxGeometry relative="1" as="geometry"/>
