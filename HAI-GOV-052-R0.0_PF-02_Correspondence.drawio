        <mxCell id="esc_d5" value="&lt;b&gt;L3&lt;/b&gt;: Manager escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;fontSize=9;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_system">
          <mxGeometry x="690" y="290" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="esc_d7" value="&lt;b&gt;L4-L5&lt;/b&gt;: Executive + Legal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=1;fontSize=9;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_system">
          <mxGeometry x="810" y="290" width="110" height="35" as="geometry"/>
        </mxCell>

        <!-- Arrows from escalation to detail boxes -->
        <mxCell id="a_esc_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C79100;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" source="step6" target="esc_d3" parent="lane_system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_esc_d5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" source="step6" target="esc_d5" parent="lane_system">
          <mxGeometry relative="1" as="geometry"/>
