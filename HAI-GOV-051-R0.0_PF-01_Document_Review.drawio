        <!-- STEP 5: HAI Technical Designated Engineer         -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="step5" value="&lt;b&gt;Step 5: HAI Technical Designated Engineer&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;ENDORSE OR REVISE STATUS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Review Consultant&amp;#39;s assigned status&lt;br&gt;Endorse as-is OR revise to different code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_hai">
          <mxGeometry x="390" y="50" width="250" height="100" as="geometry"/>
        </mxCell>

        <!-- Arrow: QC Decision A/B → Step 5 (cross-lane) -->
        <mxCell id="a_qc_s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1B5E20;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="qc_decision" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_qc_ab" value="A or B" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#1B5E20;fontFamily=Arial;fontStyle=3;" vertex="1" connectable="0" parent="a_qc_s5">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="20" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- HAI Endorsement Decision -->
        <mxCell id="hai_decision" value="HAI&lt;br&gt;Endorses?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;fontStyle=1;fontFamily=Arial;fontColor=#1B2A4A;" vertex="1" parent="lane_hai">
          <mxGeometry x="460" y="170" width="110" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow: Step 5 → HAI Decision -->
        <mxCell id="a_s5_hd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4A6FA5;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" source="step5" target="hai_decision" parent="lane_hai">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HAI Revises → back to originator (C/D) -->
        <mxCell id="hai_revise_box" value="&lt;b&gt;&lt;font color=&quot;#B71C1C&quot;&gt;STATUS REVISED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;HAI changes to C or D&lt;br&gt;R[n].m → R[(n+1)].0&lt;br&gt;Back to Originator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontSize=10;fontFamily=Arial;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="lane_hai">
          <mxGeometry x="100" y="175" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- Arrow: HAI Decision → Revise (left) -->
        <mxCell id="a_hd_rev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#B71C1C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" source="hai_decision" target="hai_revise_box" parent="lane_hai">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_hd_rev" value="Revises to C/D" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#B71C1C;fontFamily=Arial;fontStyle=3;" vertex="1" connectable="0" parent="a_hd_rev">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint y="-10" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Arrow: HAI Revise → loop back to Step 1 -->
        <mxCell id="a_hai_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#B71C1C;strokeWidth=1.5;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="hai_revise_box" target="step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="1130"/>
              <mxPoint x="100" y="275"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_hai_loop" value="Resubmit as&#xa;R[(n+1)].0" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#B71C1C;fontFamily=Arial;fontStyle=2;" vertex="1" connectable="0" parent="a_hai_loop">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="-15" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- END — Document Closed                   -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="end" value="END — Document Approved &amp; Archived" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#1B5E20;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_hai">
          <mxGeometry x="420" y="270" width="190" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrow: HAI Endorses → END -->
        <mxCell id="a_hd_end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1B5E20;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" source="hai_decision" target="end" parent="lane_hai">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_hd_end" value="Endorses A or B" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#1B5E20;fontFamily=Arial;fontStyle=3;" vertex="1" connectable="0" parent="a_hd_end">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="25" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- HAI OVERRIDE PANEL                      -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="override_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;dashed=1;dashPattern=12 4;arcSize=8;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="40" y="1260" width="1090" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="override_icon" value="⚡" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="60" y="1265" width="30" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="override_text" value="&lt;b&gt;HAI OVERRIDE AUTHORITY (SC 3.1)&lt;/b&gt;  —  Engineer (HAI) has full visibility and can intervene/override at ANY step.  Approval does not relieve Contractor from any obligation (SC 3.1 para 12).  Further docs may be requested at any time (48h response, SC 3.1).  Override logged with timestamp &amp; rationale." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#1B2A4A;fontFamily=Arial;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="95" y="1265" width="1020" height="50" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- FOOTER                                  -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="footer" value="HAI-SS-PFD-2026-001  |  Document Review &amp; Approval Process  |  CONFIDENTIAL" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=8;fontColor=#BDBDBD;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="300" y="1330" width="500" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
